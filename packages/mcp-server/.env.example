# Port to listen on. Railway injects this.
PORT=3000

# Supabase project (Project Settings → API). Local: values from `supabase status`.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
# Service role key: used ONLY for the OAuth client/code tables, never for user data.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: only for projects still signing JWTs with the legacy shared secret (HS256).
# Projects on asymmetric signing keys are verified via JWKS and don't need this.
# SUPABASE_JWT_SECRET=

# Optional: public origin, e.g. https://mcp.example.com. When unset it is derived
# from X-Forwarded-Proto / X-Forwarded-Host.
# PUBLIC_BASE_URL=
