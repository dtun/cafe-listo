{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm --filter @cafe-listo/mcp-server... build",
    "watchPatterns": [
      "packages/mcp-server/**",
      "packages/shared/**",
      "package.json",
      "pnpm-lock.yaml",
      "pnpm-workspace.yaml",
      ".npmrc",
      ".nvmrc",
      "railway.json"
    ]
  },
  "deploy": {
    "startCommand": "node --enable-source-maps packages/mcp-server/dist/index.js",
    "healthcheckPath": "/ready",
    "healthcheckTimeout": 30,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
